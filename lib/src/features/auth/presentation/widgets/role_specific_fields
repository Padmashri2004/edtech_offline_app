import 'package:flutter/material.dart';

/// Member 1: Role-Based Data Input Widget
/// This widget dynamically renders input fields based on the selected user role.
/// It ensures the correct metadata (IDs, Grade levels, etc.) is captured for the database.
class RoleSpecificFields extends StatelessWidget {
  final String selectedRole;
  final TextEditingController extraInfoController;
  final TextEditingController gradeController; // Added for Student/Parent tracking

  const RoleSpecificFields({
    super.key,
    required this.selectedRole,
    required this.extraInfoController,
    required this.gradeController,
  });

  @override
  Widget build(BuildContext context) {
    return AnimatedSwitcher(
      duration: const Duration(milliseconds: 300),
      child: _buildFieldsForRole(),
    );
  }

  Widget _buildFieldsForRole() {
    switch (selectedRole) {
      case 'Teacher':
        return Column(
          key: const ValueKey('teacher_fields'),
          children: [
            _buildTextField(
              controller: extraInfoController,
              label: 'Employee / Staff ID',
              hint: 'Enter your official school ID',
              icon: Icons.badge_outlined,
            ),
            _buildTextField(
              controller: gradeController,
              label: 'Primary Subject',
              hint: 'e.g., Mathematics, Science',
              icon: Icons.book_outlined,
            ),
          ],
        );

      case 'Student':
        return Column(
          key: const ValueKey('student_fields'),
          children: [
            _buildTextField(
              controller: extraInfoController,
              label: 'Roll Number',
              hint: 'Enter your class roll number',
              icon: Icons.numbers,
            ),
            _buildTextField(
              controller: gradeController,
              label: 'Current Grade/Class',
              hint: 'e.g., Class 6',
              icon: Icons.grade_outlined,
            ),
          ],
        );

      case 'Parent':
        return Column(
          key: const ValueKey('parent_fields'),
          children: [
            _buildTextField(
              controller: extraInfoController,
              label: "Student's Roll Number",
              hint: "Enter your child's roll number",
              icon: Icons.link,
            ),
            const Padding(
              padding: EdgeInsets.symmetric(horizontal: 12.0, vertical: 4.0),
              child: Text(
                "Linking a student ID allows you to view their quiz performance offline.",
                style: TextStyle(fontSize: 12, color: Colors.grey),
              ),
            ),
          ],
        );

      default:
        return const SizedBox.shrink();
    }
  }

  Widget _buildTextField({
    required TextEditingController controller,
    required String label,
    required String hint,
    required IconData icon,
  }) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 10.0),
      child: TextFormField(
        controller: controller,
        decoration: InputDecoration(
          labelText: label,
          hintText: hint,
          prefixIcon: Icon(icon),
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(12),
          ),
          filled: true,
          fillColor: Colors.grey[50],
        ),
        validator: (value) {
          if (value == null || value.isEmpty) {
            return 'This field is required for $selectedRole registration';
          }
          return null;
        },
      ),
    );
  }
}